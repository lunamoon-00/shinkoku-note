# 画面の設定（どれも公開して問題ない値）。手元では .env.local にコピーして使う
# 値は AWS の CloudFormation「Shinkoku」スタックの「出力」にある
NEXT_PUBLIC_API_URL=https://xxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
NEXT_PUBLIC_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# 1 にすると、AWSにつながない「お試しモード」
NEXT_PUBLIC_MOCK=0
